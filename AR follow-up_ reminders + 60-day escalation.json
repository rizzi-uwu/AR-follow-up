    {
      "parameters": {
        "jsCode": "\nconst today = $now.setZone('Europe/Berlin').startOf('day');\nconst todayStr = today.toFormat('yyyy-MM-dd');\n\n// The wait node returns only the form response, so pull the invoice list from the grouping node by position.\nconst groups = $('Group by company (60+)').all();\nconst responses = $input.all();\nconst out = [];\nresponses.forEach((item, i) => {\n  const g = groups[i].json;\n  const raw = String((item.json.data && item.json.data.Decision) || item.json.Decision || '').trim().toLowerCase();\n  let status, snoozeDays;\n  if (raw === 'sent') { status = 'Sent'; snoozeDays = null; }\n  else if (raw === 'delayed') { status = 'Delayed'; snoozeDays = 14; }\n  else if (raw === 'not processed') { status = 'Not processed'; snoozeDays = 7; }\n  else { status = 'No response'; snoozeDays = 1; } // timed out: ask again next run\n  const snooze = snoozeDays ? today.plus({ days: snoozeDays }).toFormat('yyyy-MM-dd') : '';\n  for (const id of g.invoice_ids) {\n    out.push({ json: { invoice_id: id, notice_status: status, snooze_until: snooze, decision_date: todayStr } });\n  }\n});\nreturn out;\n"
      },
