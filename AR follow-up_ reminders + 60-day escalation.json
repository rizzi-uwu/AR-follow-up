    {
      "parameters": {
        "jsCode": "\nconst today = $now.setZone('Europe/Berlin').startOf('day');\nconst todayStr = today.toFormat('yyyy-MM-dd');\n\nconst groups = {};\nfor (const { json: r } of $input.all()) {\n  const key = r.email.toLowerCase() + '|' + r.company;\n  (groups[key] = groups[key] || []).push(r);\n}\nconst fmt = (r) => `${Number(String(r.amount).replace(',', '.')).toFixed(2)} ${r.currency}`.trim();\nreturn Object.values(groups).map((rows) => {\n  rows.sort((a, b) => b.days_overdue - a.days_overdue);\n  const lines = rows.map((r) =>\n    `<li>${r.invoice_id} &ndash; ${fmt(r)}, due ${r.due_date}, <b>${r.days_overdue} days overdue</b>` +\n    `${r.last_contacted ? ', last contacted ' + r.last_contacted : ', never contacted'}</li>`).join('');\n  const message = `<p><b>${rows[0].company}</b> (${rows[0].email}) has ${rows.length} invoice(s) 60+ days overdue ` +\n    `with no formal notice recorded:</p><ul>${lines}</ul>` +\n    `<p>Choose a decision below:<br>` +\n    `<b>Sent</b> = formal notice has gone out, mark complete<br>` +\n    `<b>Delayed</b> = client granted more time, re-check in 14 days<br>` +\n    `<b>Not processed</b> = skip for now (dispute, credit hold), re-check in 7 days</p>`;\n  return { json: {\n    company: rows[0].company, email: rows[0].email,\n    invoice_ids: rows.map((r) => r.invoice_id),\n    subject: `[AR escalation] ${rows[0].company} - ${rows.length} invoice(s) 60+ days overdue`,\n    message,\n  }};\n});\n"
      },
