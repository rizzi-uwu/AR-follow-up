    {
      "parameters": {
        "jsCode": "\nconst today = $now.setZone('Europe/Berlin').startOf('day');\nconst todayStr = today.toFormat('yyyy-MM-dd');\n\nfunction parse(v) {\n  if (v === undefined || v === null || String(v).trim() === '') return null;\n  const s = String(v).trim();\n  let d = DateTime.fromISO(s, { zone: 'Europe/Berlin' });\n  if (!d.isValid) d = DateTime.fromFormat(s, 'dd.MM.yyyy', { zone: 'Europe/Berlin' });\n  if (!d.isValid) d = DateTime.fromFormat(s, 'M/d/yyyy', { zone: 'Europe/Berlin' });\n  return d.isValid ? d.startOf('day') : null;\n}\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  const status = String(r.status || '').trim().toLowerCase();\n  if (!r.invoice_id || ['paid', 'cancelled', 'void'].includes(status)) continue;\n  const due = parse(r.due_date);\n  if (!due) continue;\n  const daysOverdue = Math.floor(today.diff(due, 'days').days);\n  if (daysOverdue <= 0) continue; // not overdue yet\n  const lc = parse(r.last_contacted);\n  const snooze = parse(r.snooze_until);\n  out.push({ json: {\n    invoice_id: String(r.invoice_id).trim(),\n    company: String(r.company || '').trim(),\n    email: String(r.email || '').trim(),\n    due_date: due.toFormat('yyyy-MM-dd'),\n    amount: r.amount,\n    currency: r.currency || '',\n    days_overdue: daysOverdue,\n    last_contacted: lc ? lc.toFormat('yyyy-MM-dd') : null,\n    days_since_contact: lc ? Math.floor(today.diff(lc, 'days').days) : null,\n    notice_status: String(r.notice_status || '').trim(),\n    snooze_until: snooze ? snooze.toFormat('yyyy-MM-dd') : null,\n    snoozed: snooze ? snooze > today : false,\n  }});\n}\nreturn out;\n"
      },
