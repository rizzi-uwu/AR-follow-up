        "jsCode": "\nconst today = $now.setZone('Europe/Berlin').startOf('day');\nconst todayStr = today.toFormat('yyyy-MM-dd');\n\n// One item per invoice, aligned with the grouped items that went into Gmail.\nconst groups = $('Group by company (<60)').all();\nconst out = [];\nfor (const g of groups) {\n  for (const id of g.json.invoice_ids) out.push({ json: { invoice_id: id, last_contacted: todayStr } });\n}\nreturn out;\n"
