    {
      "parameters": {
        "jsCode": "\nconst today = $now.setZone('Europe/Berlin').startOf('day');\nconst todayStr = today.toFormat('yyyy-MM-dd');\n\nconst groups = {};\nfor (const { json: r } of $input.all()) {\n  const key = r.email.toLowerCase() + '|' + r.company;\n  (groups[key] = groups[key] || []).push(r);\n}\nconst fmt = (r) => `${Number(String(r.amount).replace(',', '.')).toFixed(2)} ${r.currency}`.trim();\nreturn Object.values(groups).map((rows) => {\n  rows.sort((a, b) => b.days_overdue - a.days_overdue);\n  const ids = rows.map((r) => r.invoice_id);\n  const shown = ids.slice(0, 3).join(', ') + (ids.length > 3 ? ` (+${ids.length - 3} more)` : '');\n  const lines = rows.map((r) =>\n    `<li>Invoice <b>${r.invoice_id}</b> &ndash; ${fmt(r)}, due ${r.due_date} (${r.days_overdue} days overdue)</li>`).join('');\n  const body = `<p>Dear ${rows[0].company} accounts team,</p>` +\n    `<p>Our records show the following ${rows.length > 1 ? 'invoices are' : 'invoice is'} still open:</p>` +\n    `<ul>${lines}</ul>` +\n    `<p>If payment has already been made, please disregard this message and send us the remittance details. ` +\n    `If you have any questions about ${rows.length > 1 ? 'these invoices' : 'this invoice'}, just reply to this email.</p>` +\n    `<p>Kind regards,<br>Accounts Receivable</p>`;\n  return { json: {\n    company: rows[0].company, email: rows[0].email, invoice_ids: ids,\n    subject: `Payment reminder: ${shown} - ${rows[0].company}`, body,\n  }};\n});\n"
      },
